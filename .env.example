# Vercel AI Gateway API key. Grants access to models via a single key with no
# per-provider SDKs. Get one at https://vercel.com/ai-gateway.
AI_GATEWAY_API_KEY=

# Full Treatwell Connect browser cookie string, pasted verbatim. Used server-side
# only, sent as the Cookie header when reading the calendar. Re-paste when your
# Treatwell session expires. (Consumed by a later ticket.)
TW_COOKIE=
